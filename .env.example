# Resume Matcher — Environment Variables
# Copy this file to .env.local and fill in the values. Never commit .env.local.

# ─────────────────────────────────────────────────────────────────────────────
# AI PROVIDER
#
# Works with any OpenAI-compatible endpoint. Pick ONE of the setups below.
# If you configure nothing at all, the app defaults to local Ollama (free).
# ─────────────────────────────────────────────────────────────────────────────

# --- Option 1: Ollama — free, local, fully private (DEFAULT) ---------------
# Install from https://ollama.com, then:  ollama pull llama3.1:8b
# No API key and no signup required. Your resume never leaves your machine.
# These are the defaults, so you can leave them commented out entirely.
#
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1:8b
#
# Running the app in Docker? Use this instead, so the container can reach
# Ollama on the host machine:
# AI_BASE_URL=http://host.docker.internal:11434/v1

# --- Option 2: Groq — free tier, hosted, no local install ------------------
# Get a key at https://console.groq.com/keys
#
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# AI_API_KEY=gsk_your-groq-key

# --- Option 3: Hugging Face Inference Providers ----------------------------
# Get a token at https://huggingface.co/settings/tokens
#
# AI_BASE_URL=https://router.huggingface.co/v1
# AI_MODEL=meta-llama/Llama-3.1-8B-Instruct
# AI_API_KEY=hf_your-token

# --- Option 4: OpenAI — paid, best output quality --------------------------
# Get a key at https://platform.openai.com/api-keys
# Setting this alone (with no AI_BASE_URL) selects OpenAI automatically.
#
# OPENAI_API_KEY=sk-your-openai-api-key-here
# AI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL FEATURES
# ─────────────────────────────────────────────────────────────────────────────

# Email delivery via Gmail SMTP
# Generate an App Password at https://myaccount.google.com/apppasswords
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# Job search API key
JOB_API_KEY=your-job-api-key
