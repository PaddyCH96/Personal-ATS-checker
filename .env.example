# Resume Matcher — Environment Variables
# Copy this file to .env.local and fill in the values

# Required: OpenAI API key for AI features (bullet rewriting, resume generation, cover letters, job intelligence)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Required: Main API key for tool access
MAIN_API_KEY=your-main-api-key

# Optional: Gmail SMTP for email delivery
# Generate an App Password at https://myaccount.google.com/apppasswords
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# Optional: Job search API key
JOB_API_KEY=your-job-api-key
